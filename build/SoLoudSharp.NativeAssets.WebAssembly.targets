<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Ships under buildTransitive/netstandard1.0/ so it reaches consumers through
    a package reference. A .targets, not a .props: it imports after the project
    body, so RuntimeIdentifier is set when the conditions below evaluate.
    Archives sit alongside in soloud.a/<emscripten-version>/, keyed by version
    because wasm objects only link against a .NET runtime pack built with the
    same emsdk.

    The archive is named without a lib prefix on purpose: the wasm pinvoke table
    matches [DllImport("soloud")] against the archive's file stem.
  -->
  <PropertyGroup>
    <SoLoudStaticLibraryPath>$(MSBuildThisFileDirectory)soloud.a</SoLoudStaticLibraryPath>
    <SoLoudEmscriptenVersion Condition="'$(SoLoudEmscriptenVersion)' == ''">6.0.2</SoLoudEmscriptenVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'browser-wasm'">
    <SoLoudStaticLibrary Include="$(SoLoudStaticLibraryPath)/$(SoLoudEmscriptenVersion)/*.a" />
    <NativeFileReference Include="@(SoLoudStaticLibrary)" />
  </ItemGroup>

</Project>
