<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'"
      >true</ContinuousIntegrationBuild
    >

    <Authors>SoLoudSharp contributors</Authors>
    <Company>SoLoudSharp</Company>
    <Copyright>Copyright (c) SoLoudSharp contributors</Copyright>
    <PackageLicenseExpression>Zlib</PackageLicenseExpression>
    <GitHubRepositoryOwner Condition="'$(GITHUB_REPOSITORY_OWNER)' != ''"
      >$(GITHUB_REPOSITORY_OWNER)</GitHubRepositoryOwner
    >
    <GitHubRepositoryOwner Condition="'$(GitHubRepositoryOwner)' == ''"
      >vrimar</GitHubRepositoryOwner
    >
    <PackageProjectUrl>https://github.com/$(GitHubRepositoryOwner)/SoLoudSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/$(GitHubRepositoryOwner)/SoLoudSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="\"
      Condition="Exists('$(MSBuildThisFileDirectory)README.md')"
    />
    <None
      Include="$(MSBuildThisFileDirectory)LICENSE"
      Pack="true"
      PackagePath="\"
      Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')"
    />
    <None
      Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md"
      Pack="true"
      PackagePath="\"
      Condition="Exists('$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md')"
    />
  </ItemGroup>
</Project>
